# ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
# ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
# └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
# spoot Spotify Client ~ Part of the ZENWORKS Suite
# https://github.com/kbuckleys/
#
# WHAT THE THREAD SANITIZER CANNOT SEE. TSan learns about synchronisation by
# watching instrumented code; Qt, libdbus, glib and lua on this machine are
# distribution builds with no instrumentation in them, so their mutexes and
# atomics are invisible and every buffer they hand between their own threads
# looks unsynchronised. The first run produced 44 of these, and in all 44 both
# conflicting accesses were inside those libraries -- spoot's frames appeared
# only as the caller that had asked for the connection.
#
# SUPPRESSED BY LIBRARY, NEVER BY OUR OWN FRAMES. `called_from_lib` drops a
# report only when the access came from inside the named library, so a race
# between two pieces of spoot's own code -- the request state and a job touching
# the same field, a shim reaching a Natives member off its own thread -- is still
# reported in full. That is the surface this target exists to watch, and nothing
# here covers it.
called_from_lib:libQt6Core.so
called_from_lib:libQt6Gui.so
called_from_lib:libQt6DBus.so
called_from_lib:libQt6Network.so
called_from_lib:libQt6Qml.so
called_from_lib:libQt6Quick.so
called_from_lib:libQt6QuickEffects.so
called_from_lib:libdbus-1.so
called_from_lib:libglib-2.0.so
called_from_lib:libgobject-2.0.so
called_from_lib:liblua.so

# libdbus takes its own two locks in both orders on its own thread. Ours are not
# in the cycle -- both frames of the report are libdbus internals.
deadlock:libdbus-1.so

# Qt's global thread pool and the D-Bus connection thread outlive main() by
# design and are reaped by the runtime, which TSan reports as leaked threads.
thread:libQt6Core.so
thread:libdbus-1.so

# The TLS stack and the rest of the glib family, for the same reason: Qt's
# network layer reaches OpenSSL and libproxy on its own threads, and neither is
# instrumented either.
called_from_lib:libcrypto.so
called_from_lib:libssl.so
called_from_lib:libgio-2.0.so
called_from_lib:libpxbackend-1.0.so
mutex:libpxbackend-1.0.so

# The graphics stack, on the same terms: Qt's Wayland client and the vendor GL
# driver both unlock mutexes on threads the sanitizer did not see them lock,
# because the locking half is inside a library it cannot read.
called_from_lib:libQt6WaylandClient.so
called_from_lib:libQt6WaylandCompositor.so
called_from_lib:libnvidia-eglcore.so
called_from_lib:libEGL_nvidia.so
called_from_lib:libGLX_nvidia.so
mutex:libQt6WaylandClient.so
mutex:libnvidia-eglcore.so
called_from_lib:libwayland-client.so
called_from_lib:libnvidia-egl-wayland2.so
called_from_lib:libffi.so
called_from_lib:libqt-plugin-wayland-egl.so
mutex:libqt-plugin-wayland-egl.so
deadlock:libwayland-client.so
deadlock:libQt6WaylandClient.so
