@import "ZENON"

window {
    location: south;
    anchor: south;
    width: 640px;
}

mainbox {
    children: [ textbox ];
}

textbox {
    text-color: #dfdfdd;
    horizontal-align: 0;
    font: "0xProto Nerd Font 13";
    padding: 15px 20px 30px 30px;
}
