* ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
* ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
* └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
* https://github.com/kbuckleys/ */

@import "ZENON"

window {
    width: 900px;
}

mainbox {
    children: [ listview ];
}

listview {
    fixed-columns: false;
    fixed-height: false;
    scrollbar: false;
    columns: 10;
    lines: 1;
}

element {
    padding: 2px 10px;
}
element-text {
    font: "0xProto Nerd Font Propo 12";
    horizontal-align: 0.5;
}
element-text selected {
    background-color: transparent;
    text-color: #b6e0a4;
    font: "0xProto Nerd Font Propo Bold 12";
}
