/**
* ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
* ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
* └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
* https://github.com/kbuckleys/ */

@import "ZENON"

window {
    width: 700px;
    children: [ wrap, listview-split ];
}

wrap {
    expand: false;
    children: [ message ];
}

listview-split {
    orientation: horizontal;
    spacing: 4px;
    children: [ icon-current-entry, listview ];
}

icon-current-entry {
    background-image: url("%s", both);
    size: 284px;
}

listview {
    lines: 11;
    scrollbar: false;
}

element {
    padding: 2px 8px;
}
element-icon {
    size: 0;
}
element-text {
    horizontal-align: 0.5;
}

message {
    background-color: #16191d;
    padding: 5px 5px 5px 5px;
}
textbox {
    text-color: #b6e0a4;
    horizontal-align: 0.5;
    font: "0xProto Nerd Font Propo, DejaVu Sans Bold 12";
}
