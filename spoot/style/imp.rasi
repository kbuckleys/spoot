/**
* ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
* ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
* └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
* https://github.com/kbuckleys/ */

@import "ZENON"

configuration {
    show-icons: true;
}

window {
    border-radius: 5px 5px 5px 5px;
    location: center;
    anchor: center;
    width: 640px;
}

mainbox {
    children: [ message, listview ];
}

listview {
    lines: 1;
    columns: 1;
    padding: 0;
}

element {
    padding: 0;
}
element-icon {
    size: 640px;
    expand: false;
}
element-text {
    enabled: false;
}

message {
    margin: 0px 0px -2px 0px;
}
textbox {
    text-color: #b6e0a4;
    font: "JetBrainsMono Nerd Font Propo Bold 12";
}
