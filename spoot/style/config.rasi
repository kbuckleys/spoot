/**
 * ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
 * ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
 * └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
 * https://github.com/kbuckleys/
 * Dummy config.rasi to allow spoot.lua to bypass global rofi's config.rasi */

configuration {
    /* free the Delete key from rofi's default remove-char-forward so
       spoot can bind it to clear-trail (custom-15) */
    kb-remove-char-forward: "Control+d";
}
