/**
 * ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
 * ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
 * └─┘└─┘┘└┘└┴┘└─┘┴└─┘┴└─┴ ┴└─┘
 * https://github.com/kbuckleys/
 *
 * The root grid, and only the root grid. Starts life as a byte-for-byte copy of
 * thumbs.rasi so nothing moves on the first draw; having its own file means the
 * five top-level tiles can be styled apart from every other thumbnail grid
 * (Collections, Podcasts, the album and playlist grids) without touching those.
 * Same precedent as pods.rasi, which forked meta.rasi for the same reason.
 *
 * The root menu still passes `thumbs=true`, so it keeps the grid's row count,
 * icon thread pool and status-line suppression -- only the theme differs. */

@import "ZENON"

* {
    selected-normal-background: none;
}

window {
    width: 1000px;
}

mainbox {
    children: [ message, listview ];
}

listview {
    padding: 0px 3px 2px 3px;
    fixed-columns: true;
    fixed-height: false;
    columns: 5;
    lines: 3;
    flow: horizontal;
    scrollbar: false;
}

element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    spacing: 4px;
    padding: 8px;
}
element selected {
    border: 2px;
    border-radius: 2px;
    border-color: #6a707f;
}
element-icon {
    size: 150px;
    horizontal-align: 0.5;
}
element-text {
    horizontal-align: 0.5;
    font: "JetBrainsMono Nerd Font Propo SemiBold 11";
    highlight: bold #b6e0a4;
}

message {
    background-color: #16191d;
    padding: 5px 30px 5px 30px;
}
/* Propo, not the mono face: in mono a Nerd Font glyph is squeezed to a single
 * fixed cell with almost no side bearing, so the one space Util.status_icons
 * emits before each of liked/explicit/lyrics reads as tighter here than in
 * every other theme. */
textbox {
    text-color: #b6e0a4;
    horizontal-align: 0.5;
    font: "JetBrainsMono Nerd Font Propo Bold 12";
}
