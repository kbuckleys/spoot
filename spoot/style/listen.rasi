/**
 * ┌─┐┌─┐┌┐┌┬ ┬┌─┐┬─┐┬┌─┌─┐
 * ┌─┘├┤ │││││││ │├┬┘├┴┐└─┐
 * └─┘└─┘┘└┘└┴┘└─┘┴└─┴ ┴└─┘
 * https://github.com/kbuckleys/
 *
 * The Listen window: style/assets/listen.png over a green caption, shown while
 * songrec identifies whatever the speakers are playing. A copy of art.rasi at
 * asset size -- art.rasi exists to fill the screen with a 1000px cover, and the
 * assets are 300x300, so reusing it would upscale a small icon by 3.3x. Same
 * one-row listview, same disabled element-text, same green textbox.
 *
 * No keybinds are unbound here on purpose: the window is dismissable and the
 * poll loop in Util.view_listen notices it going away and stops the recognition
 * with it. */

@import "ZENON"

* {
    selected-normal-background: none;
}

configuration {
    show-icons: true;
}

window {
    location: south;
    anchor: south;
    width: 304px;
}

mainbox {
    children: [ listview, message ];
}

inputbar {
    enabled: false;
}

listview {
    lines: 1;
    columns: 1;
    scrollbar: false;
    padding: -40px 0px -40px 0px;
}

element-icon {
    size: 300px;
    expand: false;
}
element-text {
    enabled: false;
}

message {
    background-color: none;
    padding: 0px 30px 30px 30px;
}
textbox {
    text-color: #b6e0a4;
    horizontal-align: 0.5;
    font: "JetBrainsMono Nerd Font Propo Bold 14";
}
